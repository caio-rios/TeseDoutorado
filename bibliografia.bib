@article{grewal_whats_2022,
	title = {What’s in a name? {Experimental} evidence of the coup taboo},
	volume = {29},
	issn = {1351-0347, 1743-890X},
	shorttitle = {What’s in a name?},
	url = {https://www.tandfonline.com/doi/full/10.1080/13510347.2022.2055550},
	doi = {10.1080/13510347.2022.2055550},
	abstract = {Leaders of military coups routinely deny that their actions amount to a coup, often labelling them as revolutions or even constitutional successions. These attempts to muddy the waters occasionally succeed in prompting discussions over whether the military’s actions truly amount to a coup. But does the label matter? Does public support for military intervention decrease when it is labelled a coup? If so, how large is this “coup taboo”? In this article, we provide the ﬁrst empirical evidence of the coup taboo across three large-scale survey experiments in Egypt, Algeria, and Tunisia. Across all three countries, we ﬁnd that the coup taboo is substantial, with support for the military hypothetically removing the president falling by 15–50 percentage points when labelled as a coup. These results underscore the importance of labels, and suggest that anti-coup norms may be superﬁcial, decreasing support for military interventions only when labelled as coups.},
	language = {en},
	number = {7},
	urldate = {2025-07-26},
	journal = {Democratization},
	author = {Grewal, Sharan and Kinney, Drew Holland},
	month = oct,
	year = {2022},
	note = {Publisher: Informa UK Limited},
	pages = {1332--1345},
	file = {PDF:C\:\\Users\\kibca\\Zotero\\storage\\V7ZHZX3P\\Grewal e Kinney - 2022 - What’s in a name Experimental evidence of the coup taboo.pdf:application/pdf},
}

